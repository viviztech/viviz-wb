# Meta WhatsApp Business API
# These, plus ANTHROPIC_API_KEY and the AWS_*/S3_* vars below, can also be left blank here and
# configured instead from the dashboard's Settings page (/settings) after first login — that's
# now the recommended way to set them, since changes there apply immediately without a restart.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=viviz_webhook_secret_2024
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# App Settings
APP_NAME=Viviz WhatsApp Business
BUSINESS_NAME=Viviz Technologies
APP_URL=https://meta.viviz.in
PRIVACY_POLICY_URL=https://meta.viviz.in/privacy
SUPPORT_EMAIL=online@viviz.in
SUPPORT_PHONE=+919344064631
WHATSAPP_BUSINESS_PHONE=+919342064631
MARKETING_MAX_MESSAGES_PER_7_DAYS=2
SECRET_KEY=change_this_to_random_secret_key_min_32_chars
ADMIN_EMAIL=admin@viviztech.in
ADMIN_PASSWORD=Admin@1234
DEBUG=false

# SMTP used for administrator password-reset links
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
PASSWORD_RESET_TTL_MINUTES=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./whatsapp.db

# Claude AI (Opus 4.7)
ANTHROPIC_API_KEY=your_anthropic_api_key

# AWS S3 (for media)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
S3_BUCKET_NAME=viviz-whatsapp-media
